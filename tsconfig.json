
{
  "compilerOptions": {
    "target": "ES6",
    "module": "ES6",

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,

    "lib": ["DOM", "ES2017"],

    "moduleResolution": "node",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true
  },
  "include": ["src"]
}